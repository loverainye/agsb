// sing-box >= 1.14.0，需包含 with_cloudflared。
// Tailscale 使用独立官方 tailscaled，不在此 JSON 中配置。
// 完整示例：PORT=19999，UUID 为演示值，WS 路径使用 UUID 前 8 位。
// 项目启动器从 AGK 注入 token；手动运行须替换 token 占位符。
// sing-box 不会自动展开环境变量。项目生成的 sb.json 不保存 token。
{
  "log": {
    "level": "debug",
    "timestamp": true
  },
  "dns": {
    "servers": [
      { "type": "local", "tag": "local-dns" }
    ],
    "final": "local-dns"
  },
  "inbounds": [
    {
      // VMess 服务：接收来自 tailscaled 用户态网络或 Cloudflare 隧道的连接。
      "type": "vmess",
      "tag": "vmess-in",
      "listen": "127.0.0.1",
      "listen_port": 19999,
      "tcp_fast_open": true,
      "proxy_protocol": false,
      "users": [
        { "uuid": "123e4567-e89b-12d3-a456-426614174000", "alterId": 0 }
      ],
      "transport": {
        "type": "ws",
        "path": "/123e4567-vm",
        "max_early_data": 2048,
        "early_data_header_name": "Sec-WebSocket-Protocol"
      }
    },
    {
      // 内置 Cloudflare Tunnel；控制台源站配置为 http://localhost:19999。
      "type": "cloudflared",
      "tag": "cloudflare-tunnel",
      "token": "<AGK>"
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "default_domain_resolver": "local-dns",
    "rules": [
      {
        // Cloudflare 隧道根据控制台配置连接本机 VMess 源站。
        "inbound": ["cloudflare-tunnel"],
        "action": "route",
        "outbound": "direct"
      }
    ],
    // VMess 解密后的客户端请求使用服务器网络访问目标。
    "final": "direct"
  }
}
